<mxCell id="title" value="Community Waste Reporting App" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="890" height="36" as="geometry"/></mxCell>
<mxCell id="subtitle" value="Serverless waste reporting system: S3+CloudFront static frontend, HTTP API Gateway routing to ARM64 Lambda functions, DynamoDB on-demand for storage. Scale-to-zero, Free Tier eligible, sustainability-aligned. · Region: us-east-1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#5A6B7B;" vertex="1" parent="1"><mxGeometry x="20" y="54" width="890" height="52" as="geometry"/></mxCell>

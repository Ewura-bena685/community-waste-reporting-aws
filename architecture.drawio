<mxCell id="users-edge-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#545B64;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#ffffff;strokeColor=#232F3E;" edge="1" parent="1" source="users" target="res-reports-api"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="edge-0" value="CloudFront fetches static assets from S3 via Origin Access Control (OAC). Bucket stays private." style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#545B64;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="res-cdn" target="res-frontend-bucket"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="edge-1" value="POST /reports routes to SubmitReport Lambda." style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#545B64;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="res-reports-api" target="res-submit-report-fn"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="edge-2" value="GET /reports routes to GetReports Lambda." style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#545B64;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="res-reports-api" target="res-get-reports-fn"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="edge-3" value="PutItem to write a new waste report with UUID, timestamp, and TTL." style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#545B64;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="res-submit-report-fn" target="res-reports-table"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="edge-4" value="Query by area-index or status-index to return reports sorted newest-first." style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#545B64;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="res-get-reports-fn" target="res-reports-table"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="cost" value="&lt;b&gt;Estimated monthly cost: $0.14&lt;/b&gt;&lt;br&gt;CloudFront Distribution: $0.10&lt;br&gt;WasteReports Table: $0.03&lt;br&gt;Reports HTTP API: $0.01&lt;br&gt;Frontend Bucket: $0.00&lt;br&gt;SubmitReport Function: $0.00&lt;br&gt;GetReports Function: $0.00&lt;br&gt;&lt;font color=&quot;#5A6B7B&quot; style=&quot;font-size: 10px;&quot;&gt;Estimate based on AWS on-demand list prices (us-east-1) and the usage assumptions shown. Free tiers are not subtracted, and data transfer between services is not included. Check the AWS Pricing Calculator before committing.&lt;/font&gt;" style="text;html=1;strokeColor=#AAB7B8;fillColor=#F8F9FA;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=11;fontColor=#232F3E;spacing=10;" vertex="1" parent="1"><mxGeometry x="170" y="710" width="520" height="204" as="geometry"/></mxCell>
